# --- Server ---
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# --- Supabase (server) ---
SUPABASE_URL=https://mock-greencorridor.supabase.co
SUPABASE_ANON_KEY=mock-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=mock-service-role-key-placeholder   # server only, NEVER expose

# --- Gemini (server only) ---
GEMINI_API_KEY=mock-gemini-key-placeholder
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEXT_TIMEOUT_MS=8000
GEMINI_VISION_TIMEOUT_MS=12000
AI_MAX_CONCURRENCY=4

# --- Rate limits ---
RATE_LIMIT_GLOBAL_PER_MIN=100
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_AI_PER_MIN=20

# --- Simulation ---
SIM_TICK_MS=500
SIM_AUTOSTART=false
